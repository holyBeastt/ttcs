<!DOCTYPE html>
<html lang="vi">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sửa Thông Tin Nhân Viên - Học Viện Kỹ Thuật Mật Mã</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="stylesheet" href="/css/styles.css">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <style>
    .form-box {
      background: #ffffff;
      border-radius: 12px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
      border: 1px solid #e9ecef;
      padding: 30px 40px;
    }

    .form-header-title {
      color: #1e3a8a;
      font-weight: 700;
      font-size: 1.65rem;
    }

    .form-section-title {
      font-size: 1.05rem;
      font-weight: 600;
      color: #1e3a8a;
      background-color: #f1f5f9;
      border-left: 4px solid #3b82f6;
      padding: 8px 14px;
      border-radius: 4px;
      margin-top: 24px;
      margin-bottom: 18px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .form-label {
      font-weight: 600;
      font-size: 0.9rem;
      color: #334155;
      margin-bottom: 6px;
    }

    .input-wrapper .form-control,
    .input-wrapper .form-select {
      background-color: #ffffff;
      border: 1px solid #cbd5e1;
      border-radius: 6px;
      padding: 9px 12px;
      font-size: 0.925rem;
      color: #1e293b;
      box-shadow: none;
      transition: all 0.2s ease-in-out;
      width: 100% !important;
    }

    .input-wrapper .form-control:focus,
    .input-wrapper .form-select:focus {
      border-color: #3b82f6 !important;
      box-shadow: 0 0 0 0.2rem rgba(59, 130, 246, 0.18) !important;
      outline: none !important;
    }

    .input-wrapper .form-control[readonly] {
      background-color: #f8fafc;
      color: #475569;
      cursor: not-allowed;
    }

    /* Ngăn icon lỗi/thành công Bootstrap đè lên nút lịch của ô input date */
    .input-wrapper input[type="date"].is-invalid,
    .input-wrapper .form-control[type="date"].is-invalid,
    input[type="date"].is-invalid,
    .input-wrapper input[type="date"].is-valid,
    .input-wrapper .form-control[type="date"].is-valid,
    input[type="date"].is-valid {
      background-image: none !important;
      padding-right: 12px !important;
    }

    #btnUpdateNV {
      background-color: #2563eb !important;
      border-color: #2563eb !important;
      color: #ffffff !important;
      font-weight: 600;
      border-radius: 6px;
      transform: none !important;
      box-shadow: 0 4px 10px rgba(37, 99, 235, 0.25);
    }

    #btnUpdateNV:hover {
      background-color: #1d4ed8 !important;
      transform: translateY(-1px) !important;
    }

    #btnUpdateNV::before,
    #btnTroVe::before {
      display: none !important;
    }

    #btnTroVe {
      background-color: #f1f5f9 !important;
      border: 1px solid #cbd5e1 !important;
      color: #475569 !important;
      font-weight: 600;
      border-radius: 6px;
      transform: none !important;
    }

    #btnTroVe:hover {
      background-color: #e2e8f0 !important;
      color: #1e293b !important;
    }
  </style>
</head>

<body>
  <%- include('adminHeader') %>

  <div class="container my-5">
    <div class="form-box">
      <!-- Header Tiêu đề -->
      <div class="d-flex align-items-center justify-content-between mb-2">
        <h2 class="form-header-title mb-0">
          <i class="bi bi-pencil-square me-2 text-primary"></i>Sửa Thông Tin Nhân Viên
        </h2>
        <span class="badge bg-light text-secondary border px-3 py-2">Mã NV: <%= value.MaNhanVien || value.id_User %></span>
      </div>
      <p class="text-muted small mb-4">Cập nhật thông tin chi tiết nhân viên vào biểu mẫu dưới đây.</p>

      <form id="updateNV" action="/updateNV/:id" method="POST">
        <input type="hidden" id="Id_User" name="Id_User" value="<%= value.id_User %>">

        <!-- ================= KHỐI 1: THÔNG TIN CÁ NHÂN & CCCD ================= -->
        <div class="form-section-title">
          <i class="bi bi-person-vcard"></i> 1. Thông tin cá nhân & Giấy tờ
        </div>

        <div class="row g-3">
          <div class="col-md-4 input-wrapper">
            <label for="TenNhanVien" class="form-label">Tên Nhân Viên <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="TenNhanVien" name="TenNhanVien" value="<%= value.TenNhanVien ? value.TenNhanVien.trim() : '' %>" required />
          </div>

          <div class="col-md-4 input-wrapper">
            <label for="NgaySinh" class="form-label">Ngày Sinh <span class="text-danger">*</span></label>
            <input type="date" class="form-control text-center" id="NgaySinh" name="NgaySinh" value="<%= value.NgaySinh ? new Date(value.NgaySinh).toISOString().split('T')[0] : '' %>" required />
          </div>

          <div class="col-md-4 input-wrapper">
            <label for="gioitinh" class="form-label">Giới tính <span class="text-danger">*</span></label>
            <select class="form-select text-center" name="GioiTinh" id="gioitinh" required>
              <option value="Nam" <%= value.GioiTinh === 'Nam' ? 'selected' : '' %>>Nam</option>
              <option value="Nữ" <%= value.GioiTinh === 'Nữ' ? 'selected' : '' %>>Nữ</option>
            </select>
          </div>

          <div class="col-md-4 input-wrapper">
            <label for="CCCD" class="form-label">Số CCCD <span class="text-danger">*</span></label>
            <input type="text" class="form-control text-center" id="CCCD" name="CCCD" maxlength="12" value="<%= value.CCCD || '' %>" required />
          </div>

          <div class="col-md-4 input-wrapper">
            <label for="NgayCapCCCD" class="form-label">Ngày Cấp CCCD</label>
            <input type="date" class="form-control text-center" id="NgayCapCCCD" name="NgayCapCCCD" value="<%= value.NgayCapCCCD ? new Date(value.NgayCapCCCD).toISOString().split('T')[0] : '' %>" />
          </div>

          <div class="col-md-4 input-wrapper">
            <label for="NoiCapCCCD" class="form-label">Nơi Cấp CCCD</label>
            <input type="text" class="form-control" id="NoiCapCCCD" name="NoiCapCCCD" value="<%= value.NoiCapCCCD || '' %>" />
          </div>

          <div class="col-md-4 input-wrapper">
            <label for="DienThoai" class="form-label">Điện Thoại</label>
            <input type="tel" class="form-control text-center" id="DienThoai" name="DienThoai" maxlength="15" value="<%= value.DienThoai || '' %>" />
          </div>

          <div class="col-md-4 input-wrapper">
            <label for="DiaChiCCCD" class="form-label">Địa Chỉ trong CCCD</label>
            <input type="text" class="form-control" id="DiaChiCCCD" name="DiaChiCCCD" value="<%= value.DiaChiCCCD || '' %>" />
          </div>

          <div class="col-md-4 input-wrapper">
            <label for="DiaChiHienNay" class="form-label">Địa Chỉ Hiện Nay</label>
            <input type="text" class="form-control" id="DiaChiHienNay" name="DiaChiHienNay" value="<%= value.DiaChiHienNay || '' %>" />
          </div>
        </div>

        <!-- ================= KHỐI 2: THÔNG TIN CÔNG TÁC & PHÂN QUYỀN ================= -->
        <div class="form-section-title">
          <i class="bi bi-briefcase"></i> 2. Thông tin công tác & Phân quyền
        </div>

        <div class="row g-3">
          <div class="col-md-4 input-wrapper">
            <label for="MaPhongBan" class="form-label">Mã Phòng Ban <span class="text-danger">*</span></label>
            <select class="form-select text-center" id="MaPhongBan" name="MaPhongBan" onchange="fetchQuyen(); fetchBoMon();" required>
              <option value="<%= role.MaPhongBan %>" selected><%= role.MaPhongBan %></option>
              <% departmentLists.forEach(function(department) { %>
                <% if (department.MaPhongBan !== role.MaPhongBan) { %>
                  <option value="<%= department.MaPhongBan %>"><%= department.MaPhongBan %></option>
                <% } %>
              <% }); %>
            </select>
          </div>

          <div class="col-md-4 input-wrapper">
            <label for="MonGiangDayChinh" class="form-label">Bộ Môn</label>
            <select class="form-select text-center" name="MonGiangDayChinh" id="MonGiangDayChinh"></select>
            <input type="text" id="boMon" value="<%= value.MonGiangDayChinh %>" hidden>
          </div>

          <div class="col-md-4 input-wrapper">
            <label for="ChucVu" class="form-label">Chức Vụ <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="ChucVu" name="ChucVu" value="<%= value.ChucVu || '' %>" required />
          </div>

          <div class="col-md-4 input-wrapper">
            <label for="HocVi" class="form-label">Học Hàm / Học Vị <span class="text-danger">*</span></label>
            <select class="form-select text-center" name="HocVi" id="HocVi" required>
              <option value="Cử nhân" <%= value.HocVi === "Cử nhân" ? "selected" : "" %>>Cử nhân</option>
              <option value="Kỹ sư" <%= value.HocVi === "Kỹ sư" ? "selected" : "" %>>Kỹ sư</option>
              <option value="Thạc sĩ" <%= value.HocVi === "Thạc sĩ" ? "selected" : "" %>>Thạc sĩ</option>
              <option value="Tiến sĩ" <%= value.HocVi === "Tiến sĩ" ? "selected" : "" %>>Tiến sĩ</option>
              <option value="Phó giáo sư. Tiến sĩ" <%= value.HocVi === "Phó giáo sư. Tiến sĩ" ? "selected" : "" %>>Phó giáo sư. Tiến sĩ</option>
              <option value="Giáo sư. Tiến sĩ" <%= value.HocVi === "Giáo sư. Tiến sĩ" ? "selected" : "" %>>Giáo sư. Tiến sĩ</option>
            </select>
          </div>

          <div class="col-md-4 input-wrapper">
            <label for="Quyen" class="form-label">Quyền Truy Cập <span class="text-danger">*</span></label>
            <select id="Quyen" class="form-select text-center" name="Quyen" required>
              <option value="<%= role.Quyen %>" selected><%= role.Quyen %></option>
            </select>
          </div>

          <div class="col-md-4 input-wrapper">
            <label for="tinhTrang" class="form-label">Tình Trạng Giảng Dạy</label>
            <select class="form-select text-center" name="tinhTrangGiangDay" id="tinhTrang">
              <option value="1" <%= value.TinhTrangGiangDay == 1 ? 'selected' : '' %>>Đang giảng dạy</option>
              <option value="0" <%= value.TinhTrangGiangDay == 0 ? 'selected' : '' %>>Đã ngừng giảng dạy</option>
            </select>
          </div>

          <div class="col-md-6 input-wrapper">
            <label for="NoiCongTac" class="form-label">Nơi Công Tác</label>
            <input type="text" class="form-control" id="NoiCongTac" name="NoiCongTac" value="<%= value.NoiCongTac || '' %>" />
          </div>

          <div class="col-md-6 input-wrapper">
            <label for="CacMonLienQuan" class="form-label">Các Môn Liên Quan</label>
            <input type="text" class="form-control" id="CacMonLienQuan" name="CacMonLienQuan" value="<%= value.CacMonLienQuan || '' %>" />
          </div>
        </div>

        <!-- ================= KHỐI 3: LƯƠNG & CHẾ ĐỘ & TÀI CHÍNH ================= -->
        <div class="form-section-title">
          <i class="bi bi-cash-stack"></i> 3. Chế độ lương & Tài chính
        </div>

        <div class="row g-3">
          <div class="col-md-3 input-wrapper">
            <label for="HSL" class="form-label">Hệ số lương <span class="text-danger">*</span></label>
            <input type="text" class="form-control text-center" id="HSL" name="HSL" value="<%= value.HSL != null ? value.HSL : '' %>" required />
          </div>

          <div class="col-md-3 input-wrapper">
            <label for="Luong" class="form-label">Lương <span class="text-danger">*</span></label>
            <input type="text" class="form-control text-center" id="Luong" name="Luong" value="<%= value.Luong != null ? value.Luong : '' %>" required />
          </div>

          <div class="col-md-3 input-wrapper">
            <label for="LyDo" class="form-label">Lý do miễn giảm</label>
            <select class="form-select text-center" name="LyDo" id="LyDo" onchange="layPhanTramTuLyDo()"></select>
          </div>

          <div class="col-md-3 input-wrapper">
            <label for="PhanTramMienGiam" class="form-label">Phần trăm miễn giảm</label>
            <input type="text" class="form-control text-center bg-light" id="PhanTramMienGiam" name="PhanTramMienGiam" value="<%= value.PhanTramMienGiam != null ? value.PhanTramMienGiam + ' %' : '0 %' %>" readonly />
          </div>

          <div class="col-md-3 input-wrapper">
            <label for="MaSoThue" class="form-label">Mã Số Thuế</label>
            <input type="text" class="form-control text-center" id="MaSoThue" name="MaSoThue" value="<%= value.MaSoThue || '' %>" />
          </div>

          <div class="col-md-3 input-wrapper">
            <label for="SoTaiKhoan" class="form-label">Số Tài Khoản</label>
            <input type="text" class="form-control text-center" id="SoTaiKhoan" name="SoTaiKhoan" value="<%= value.SoTaiKhoan || '' %>" />
          </div>

          <div class="col-md-3 input-wrapper">
            <label for="NganHang" class="form-label">Ngân Hàng</label>
            <input type="text" class="form-control" id="NganHang" name="NganHang" value="<%= value.NganHang || '' %>" />
          </div>

          <div class="col-md-3 input-wrapper">
            <label for="ChiNhanh" class="form-label">Chi Nhánh</label>
            <input type="text" class="form-control" id="ChiNhanh" name="ChiNhanh" value="<%= value.ChiNhanh || '' %>" />
          </div>
        </div>

        <!-- ================= KHỐI 4: TÀI KHOẢN HỆ THỐNG ================= -->
        <div class="form-section-title">
          <i class="bi bi-shield-lock"></i> 4. Tài khoản hệ thống
        </div>

        <div class="row g-3">
          <div class="col-md-6 input-wrapper">
            <label for="TenDangNhap" class="form-label">Tên đăng nhập</label>
            <input type="text" class="form-control text-center bg-light" id="TenDangNhap" name="TenDangNhap" value="<%= account.TenDangNhap %>" readonly />
            <div class="form-text text-muted mt-2">
              <i class="bi bi-lock me-1"></i>Tên đăng nhập là định danh cố định không thể chỉnh sửa.
            </div>
          </div>
        </div>

        <!-- ================= ACTION BUTTONS ================= -->
        <div class="d-flex flex-wrap justify-content-between align-items-center mt-4 pt-3 border-top">
          <div class="text-muted small mb-2 mb-md-0">
            <span class="text-danger fw-bold">*</span> Những ô có dấu sao là thông tin bắt buộc.
          </div>
          <div>
            <button type="button" class="btn me-2" id="btnTroVe" onclick="window.location.href='/nhanVien'">
              <i class="bi bi-arrow-left me-1"></i> Trở về
            </button>
            <button type="submit" class="btn" id="btnUpdateNV">
              <i class="bi bi-check2-circle me-1"></i> Lưu Thay Đổi
            </button>
          </div>
        </div>
      </form>
    </div>
  </div>

  <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

  <script>
    function decodeHTMLEntities(text) {
      const textArea = document.createElement('textarea');
      textArea.innerHTML = text;
      return textArea.value;
    }

    document.addEventListener("DOMContentLoaded", function() {
      const khoa = parseInt("<%= role.isKhoa %>");
      const maPhongBan = decodeHTMLEntities("<%= role.MaPhongBan %>");
      const quyenSelect = document.getElementById('Quyen');

      const phongKhaoThi = (maPhongBan === APP_DEPARTMENTS.ktDbcl && khoa === 0);

      if (khoa === 1) {
        quyenSelect.innerHTML = `
        <option value="${APP_ROLES.gv_khoa}">Giảng Viên</option>
        <option value="${APP_ROLES.gv_cnbm_khoa}">Giáo vụ - Chủ nhiệm bộ môn</option>
        <option value="${APP_ROLES.lanhDao_khoa}">Lãnh đạo khoa</option>`;
      } else {
        quyenSelect.innerHTML = `
        <option value="${APP_ROLES.lanhDao_phong}">Lãnh đạo</option>
        <option value="${APP_ROLES.troLy_phong}">Trợ lý</option>
        <option value="${APP_ROLES.thuong}">Thường</option>`;
      }
      const quyenValue = "<%= role.Quyen %>";

      const optionToSelect = quyenSelect.querySelector(`option[value="${quyenValue}"]`);
      if (optionToSelect) {
        optionToSelect.selected = true;
      }
      fetchLyDo();
    });

    $(document).ready(function() {
      $("#updateNV").on("submit", function(e) {
        e.preventDefault();

        var formData = $(this).serialize();
        var userId = $("#Id_User").val();
        var url = "/updateNV/" + userId;

        $.ajax({
          url: url,
          type: "POST",
          data: formData,
          success: function(response) {
            Swal.fire({
              title: "Thành công!",
              text: response.message || "Cập nhật thông tin nhân viên thành công!",
              icon: "success",
              confirmButtonText: "Đồng ý",
            }).then(() => {
              window.location.href = "/nhanVien";
            });
          },
          error: function(xhr, status, error) {
            try {
              var response = JSON.parse(xhr.responseText);
              Swal.fire({
                title: "Thông báo lỗi",
                text: response.message || "Đã xảy ra lỗi",
                icon: "error",
                confirmButtonText: "Đóng",
              });
            } catch (e) {
              Swal.fire({
                title: "Thông báo lỗi",
                text: "Đã xảy ra lỗi: " + xhr.responseText,
                icon: "error",
                confirmButtonText: "Đóng",
              });
            }
          },
        });
      });
    });

    function fetchQuyen() {
      const maPhongBan = decodeHTMLEntities(document.getElementById('MaPhongBan').value);
      fetch(`/getQuyenByPhongBan?MaPhongBan=${encodeURIComponent(maPhongBan)}`)
        .then(response => response.json())
        .then(data => {
          const quyenSelect = document.getElementById('Quyen');
          quyenSelect.innerHTML = '';

          const phongKhaoThi = (maPhongBan === APP_DEPARTMENTS.ktDbcl && data.isKhoa === 0);

          if (data.isKhoa === 1) {
            quyenSelect.innerHTML = `
              <option value="${APP_ROLES.gv_khoa}">Giảng Viên</option>
              <option value="${APP_ROLES.gv_cnbm_khoa}">Giảng viên-Chủ nhiệm bộ môn</option>
              <option value="${APP_ROLES.lanhDao_khoa}">Lãnh đạo khoa</option>`;
          } else if (phongKhaoThi) {
            quyenSelect.innerHTML = `
              <option value="${APP_ROLES.lanhDao_phong}">Lãnh đạo</option>
              <option value="${APP_ROLES.troLy_phong}">Trợ lý</option>
              <option value="${APP_ROLES.thuong}">Thường</option>`;
          } else {
            quyenSelect.innerHTML = `
              <option value="${APP_ROLES.lanhDao_phong}">Lãnh đạo</option>
              <option value="${APP_ROLES.thuong}">Thường</option>
              <option value="${APP_ROLES.troLy_phong}">Trợ lý</option>`;
          }
        })
        .catch(error => console.error('Error fetching quyen:', error));
    }

    document.addEventListener("DOMContentLoaded", function() {
      const maPhongBan = document.getElementById("MaPhongBan").value;
      const monGiangDayChinh = document.getElementById("boMon").value;

      fetch(`/getMaBoMon/${encodeURIComponent(maPhongBan)}`)
        .then(response => response.json())
        .then(data => {
          const maBoMonSelect = document.getElementById('MonGiangDayChinh');
          if (!maBoMonSelect) return;
          maBoMonSelect.innerHTML = '';
          let foundMatch = false;

          if (data.success && data.maBoMon) {
            data.maBoMon.forEach(item => {
              const option = document.createElement('option');
              option.value = item.MaBoMon;
              option.textContent = item.TenBoMon;

              if (item.MaBoMon === monGiangDayChinh) {
                option.selected = true;
                foundMatch = true;
              }
              maBoMonSelect.appendChild(option);
            });
          }
        })
        .catch(error => {
          console.error('Error fetching bo mon:', error);
          const maBoMonSelect = document.getElementById('MonGiangDayChinh');
          if (maBoMonSelect) {
            maBoMonSelect.innerHTML = '<option value="">Chọn bộ môn</option>';
          }
        });
    });

    function fetchBoMon() {
      const maPhongBan = document.getElementById("MaPhongBan").value;
      fetch(`/getMaBoMon/${encodeURIComponent(maPhongBan)}`)
        .then(response => response.json())
        .then(data => {
          const maBoMonSelect = document.getElementById('MonGiangDayChinh');
          if (!maBoMonSelect) return;
          maBoMonSelect.innerHTML = '';

          if (data.success && data.maBoMon) {
            data.maBoMon.forEach(item => {
              const option = document.createElement('option');
              option.value = item.MaBoMon;
              option.textContent = item.TenBoMon;
              maBoMonSelect.appendChild(option);
            });
          }
        })
        .catch(error => console.error('Error:', error));
    }

    function fetchLyDo() {
      const LyDo = "<%= value.LyDoMienGiam %>";
      fetch(`/getmiengiam`)
        .then(response => response.json())
        .then(data => {
          const lyDoSelect = document.getElementById('LyDo');
          if (!lyDoSelect) return;
          lyDoSelect.innerHTML = '';

          if (data && data.lydo) {
            data.lydo.forEach(item => {
              const option = document.createElement('option');
              option.value = item.LyDo;
              option.textContent = item.LyDo;
              if (item.LyDo === LyDo) {
                option.selected = true;
              }
              lyDoSelect.appendChild(option);
            });
          }
          layPhanTramTuLyDo();
        })
        .catch(error => console.error('Error:', error));
    }

    function layPhanTramTuLyDo() {
      const lyDoSelect = document.getElementById('LyDo');
      if (!lyDoSelect) return;
      const lyDoValue = lyDoSelect.value;

      if (!lyDoValue) {
        document.getElementById('PhanTramMienGiam').value = '0 %';
        return;
      }

      fetch(`/getphantram/${encodeURIComponent(lyDoValue)}`)
        .then(response => response.json())
        .then(data => {
          if (data.phanTram && data.phanTram[0]) {
            document.getElementById('PhanTramMienGiam').value = data.phanTram[0].PhanTramMienGiam + ' %';
          } else {
            document.getElementById('PhanTramMienGiam').value = '0 %';
          }
        })
        .catch(error => {
          console.error('Lỗi khi lấy phần trăm miễn giảm:', error);
          document.getElementById('PhanTramMienGiam').value = '0 %';
        });
    }
  </script>
</body>
</html>
