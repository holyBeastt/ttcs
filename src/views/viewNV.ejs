<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Chi Tiết Nhân Viên - Học Viện Kỹ Thuật Mật Mã</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
  <link rel="stylesheet" href="/css/admin.css" />
  <link rel="stylesheet" href="/css/styles.css" />
  <style>
    .form-box {
      background: #ffffff;
      border-radius: 12px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
      border: 1px solid #e9ecef;
      padding: 30px 40px;
    }

    .form-header-title {
      color: #1e3a8a;
      font-weight: 700;
      font-size: 1.65rem;
    }

    .form-section-title {
      font-size: 1.05rem;
      font-weight: 600;
      color: #1e3a8a;
      background-color: #f1f5f9;
      border-left: 4px solid #3b82f6;
      padding: 8px 14px;
      border-radius: 4px;
      margin-top: 24px;
      margin-bottom: 18px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .form-label {
      font-weight: 600;
      font-size: 0.9rem;
      color: #334155;
      margin-bottom: 6px;
    }

    .input-wrapper .form-control {
      background-color: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 6px;
      padding: 9px 12px;
      font-size: 0.925rem;
      color: #1e293b;
      cursor: default;
      width: 100% !important;
    }

    .input-wrapper .form-control:focus {
      background-color: #f8fafc;
      border-color: #cbd5e1;
      box-shadow: none;
    }

    #btnSuaNV {
      background-color: #2563eb !important;
      border-color: #2563eb !important;
      color: #ffffff !important;
      font-weight: 600;
      border-radius: 6px;
      padding: 9px 20px;
      box-shadow: 0 4px 10px rgba(37, 99, 235, 0.25);
      text-decoration: none;
      display: inline-flex;
      align-items: center;
    }

    #btnSuaNV:hover {
      background-color: #1d4ed8 !important;
      color: #ffffff !important;
      transform: translateY(-1px);
    }

    #btnTroVe {
      background-color: #f1f5f9 !important;
      border: 1px solid #cbd5e1 !important;
      color: #475569 !important;
      font-weight: 600;
      border-radius: 6px;
      padding: 9px 20px;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
    }

    #btnTroVe:hover {
      background-color: #e2e8f0 !important;
      color: #1e293b !important;
    }
  </style>
</head>

<body>
  <%- include('adminHeader') %>

  <!-- Main content -->
  <div class="container my-5">
    <div class="form-box">
      <!-- Header Tiêu đề & Badges -->
      <div class="d-flex flex-wrap align-items-center justify-content-between mb-2">
        <h2 class="form-header-title mb-0">
          <i class="bi bi-person-lines-fill me-2 text-primary"></i>Hồ Sơ Chi Tiết Nhân Viên
        </h2>
        <div class="d-flex align-items-center gap-2 mt-2 mt-md-0">
          <span class="badge bg-light text-secondary border px-3 py-2">
            Mã NV: <%= value.MaNhanVien || value.id_User %>
          </span>
          <% if (value.TinhTrangGiangDay == 1) { %>
            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2">
              <i class="bi bi-check-circle me-1"></i> Đang giảng dạy
            </span>
          <% } else { %>
            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-3 py-2">
              <i class="bi bi-dash-circle me-1"></i> Đã ngừng giảng dạy
            </span>
          <% } %>
        </div>
      </div>
      <p class="text-muted small mb-4">Xem thông tin hồ sơ nhân viên trong hệ thống (chế độ chỉ xem).</p>

      <form id="viewNV">
        <!-- ================= KHỐI 1: THÔNG TIN CÁ NHÂN & CCCD ================= -->
        <div class="form-section-title">
          <i class="bi bi-person-vcard"></i> 1. Thông tin cá nhân & Giấy tờ
        </div>

        <div class="row g-3">
          <div class="col-md-4 input-wrapper">
            <label for="TenNhanVien" class="form-label">Tên Nhân Viên</label>
            <input
              type="text"
              class="form-control"
              id="TenNhanVien"
              value="<%= value.TenNhanVien ? value.TenNhanVien.trim() : '' %>"
              readonly
            />
          </div>

          <div class="col-md-4 input-wrapper">
            <label for="NgaySinh" class="form-label">Ngày Sinh</label>
            <input
              type="date"
              class="form-control text-center"
              id="NgaySinh"
              value="<%= value.NgaySinh ? new Date(value.NgaySinh).toISOString().split('T')[0] : '' %>"
              readonly
            />
          </div>

          <div class="col-md-4 input-wrapper">
            <label for="gioitinh" class="form-label">Giới tính</label>
            <input
              type="text"
              class="form-control text-center"
              id="gioitinh"
              value="<%= value.GioiTinh || '' %>"
              readonly
            />
          </div>

          <div class="col-md-4 input-wrapper">
            <label for="CCCD" class="form-label">Số CCCD</label>
            <input
              type="text"
              class="form-control text-center"
              id="CCCD"
              value="<%= value.CCCD || '' %>"
              readonly
            />
          </div>

          <div class="col-md-4 input-wrapper">
            <label for="NgayCapCCCD" class="form-label">Ngày Cấp CCCD</label>
            <input
              type="date"
              class="form-control text-center"
              id="NgayCapCCCD"
              value="<%= value.NgayCapCCCD ? new Date(value.NgayCapCCCD).toISOString().split('T')[0] : '' %>"
              readonly
            />
          </div>

          <div class="col-md-4 input-wrapper">
            <label for="NoiCapCCCD" class="form-label">Nơi Cấp CCCD</label>
            <input
              type="text"
              class="form-control"
              id="NoiCapCCCD"
              value="<%= value.NoiCapCCCD || '' %>"
              readonly
            />
          </div>

          <div class="col-md-4 input-wrapper">
            <label for="DienThoai" class="form-label">Điện Thoại</label>
            <input
              type="tel"
              class="form-control text-center"
              id="DienThoai"
              value="<%= value.DienThoai || '' %>"
              readonly
            />
          </div>

          <div class="col-md-4 input-wrapper">
            <label for="DiaChiCCCD" class="form-label">Địa Chỉ trong CCCD</label>
            <input
              type="text"
              class="form-control"
              id="DiaChiCCCD"
              value="<%= value.DiaChiCCCD || '' %>"
              readonly
            />
          </div>

          <div class="col-md-4 input-wrapper">
            <label for="DiaChiHienNay" class="form-label">Địa Chỉ Hiện Nay</label>
            <input
              type="text"
              class="form-control"
              id="DiaChiHienNay"
              value="<%= value.DiaChiHienNay || '' %>"
              readonly
            />
          </div>
        </div>

        <!-- ================= KHỐI 2: THÔNG TIN CÔNG TÁC & PHÂN QUYỀN ================= -->
        <div class="form-section-title">
          <i class="bi bi-briefcase"></i> 2. Thông tin công tác & Phân quyền
        </div>

        <div class="row g-3">
          <div class="col-md-4 input-wrapper">
            <label for="MaPhongBan" class="form-label">Mã Phòng Ban</label>
            <input
              type="text"
              class="form-control text-center"
              id="MaPhongBan"
              value="<%= role.MaPhongBan || '' %>"
              readonly
            />
          </div>

          <div class="col-md-4 input-wrapper">
            <label for="MonGiangDayChinh" class="form-label">Bộ Môn</label>
            <input
              type="text"
              class="form-control text-center"
              id="MonGiangDayChinh"
              value="<%= tenBoMon.TenBoMon || 'Không có' %>"
              readonly
            />
          </div>

          <div class="col-md-4 input-wrapper">
            <label for="ChucVu" class="form-label">Chức Vụ</label>
            <input
              type="text"
              class="form-control"
              id="ChucVu"
              value="<%= value.ChucVu || '' %>"
              readonly
            />
          </div>

          <div class="col-md-4 input-wrapper">
            <label for="HocVi" class="form-label">Học Hàm / Học Vị</label>
            <input
              type="text"
              class="form-control text-center"
              id="HocVi"
              value="<%= value.HocVi || '' %>"
              readonly
            />
          </div>

          <div class="col-md-4 input-wrapper">
            <label for="Quyen" class="form-label">Quyền Truy Cập</label>
            <input
              type="text"
              class="form-control text-center"
              id="Quyen"
              value="<%= role.Quyen || '' %>"
              readonly
            />
          </div>

          <div class="col-md-4 input-wrapper">
            <label for="tinhTrang" class="form-label">Tình Trạng Giảng Dạy</label>
            <input
              type="text"
              class="form-control text-center"
              id="tinhTrang"
              value="<%= value.TinhTrangGiangDay == 1 ? 'Đang giảng dạy' : 'Đã ngừng giảng dạy' %>"
              readonly
            />
          </div>

          <div class="col-md-6 input-wrapper">
            <label for="NoiCongTac" class="form-label">Nơi Công Tác</label>
            <input
              type="text"
              class="form-control"
              id="NoiCongTac"
              value="<%= value.NoiCongTac || '' %>"
              readonly
            />
          </div>

          <div class="col-md-6 input-wrapper">
            <label for="CacMonLienQuan" class="form-label">Các Môn Liên Quan</label>
            <input
              type="text"
              class="form-control"
              id="CacMonLienQuan"
              value="<%= value.CacMonLienQuan || '' %>"
              readonly
            />
          </div>
        </div>

        <!-- ================= KHỐI 3: LƯƠNG & CHẾ ĐỘ & TÀI CHÍNH ================= -->
        <div class="form-section-title">
          <i class="bi bi-cash-stack"></i> 3. Chế độ lương & Tài chính
        </div>

        <div class="row g-3">
          <div class="col-md-3 input-wrapper">
            <label for="HSL" class="form-label">Hệ Số Lương</label>
            <input
              type="text"
              class="form-control text-center"
              id="HSL"
              value="<%= value.HSL != null ? value.HSL : '' %>"
              readonly
            />
          </div>

          <div class="col-md-3 input-wrapper">
            <label for="Luong" class="form-label">Lương</label>
            <input
              type="text"
              class="form-control text-center"
              id="Luong"
              value="<%= value.Luong != null ? value.Luong : '' %>"
              readonly
            />
          </div>

          <div class="col-md-3 input-wrapper">
            <label for="LyDo" class="form-label">Lý Do Miễn Giảm</label>
            <input
              type="text"
              class="form-control text-center"
              id="LyDo"
              value="<%= value.LyDoMienGiam || 'Không có' %>"
              readonly
            />
          </div>

          <div class="col-md-3 input-wrapper">
            <label for="PhanTramMienGiam" class="form-label">Phần Trăm Miễn Giảm</label>
            <input
              type="text"
              class="form-control text-center"
              id="PhanTramMienGiam"
              value="<%= value.PhanTramMienGiam != null ? value.PhanTramMienGiam + ' %' : '0 %' %>"
              readonly
            />
          </div>

          <div class="col-md-3 input-wrapper">
            <label for="MaSoThue" class="form-label">Mã Số Thuế</label>
            <input
              type="text"
              class="form-control text-center"
              id="MaSoThue"
              value="<%= value.MaSoThue || '' %>"
              readonly
            />
          </div>

          <div class="col-md-3 input-wrapper">
            <label for="SoTaiKhoan" class="form-label">Số Tài Khoản</label>
            <input
              type="text"
              class="form-control text-center"
              id="SoTaiKhoan"
              value="<%= value.SoTaiKhoan || '' %>"
              readonly
            />
          </div>

          <div class="col-md-3 input-wrapper">
            <label for="NganHang" class="form-label">Ngân Hàng</label>
            <input
              type="text"
              class="form-control"
              id="NganHang"
              value="<%= value.NganHang || '' %>"
              readonly
            />
          </div>

          <div class="col-md-3 input-wrapper">
            <label for="ChiNhanh" class="form-label">Chi Nhánh</label>
            <input
              type="text"
              class="form-control"
              id="ChiNhanh"
              value="<%= value.ChiNhanh || '' %>"
              readonly
            />
          </div>
        </div>

        <!-- ================= KHỐI 4: TÀI KHOẢN HỆ THỐNG ================= -->
        <div class="form-section-title">
          <i class="bi bi-shield-lock"></i> 4. Tài khoản hệ thống
        </div>

        <div class="row g-3">
          <div class="col-md-6 input-wrapper">
            <label for="TenDangNhap" class="form-label">Tên Đăng Nhập</label>
            <input
              type="text"
              class="form-control text-center"
              id="TenDangNhap"
              value="<%= account.TenDangNhap || '' %>"
              readonly
            />
            <div class="form-text text-muted mt-2">
              <i class="bi bi-shield-check text-success me-1"></i>Tài khoản đăng nhập được liên kết với hồ sơ nhân viên này.
            </div>
          </div>
        </div>

        <!-- ================= HÀNH ĐỘNG ================= -->
        <div class="d-flex flex-wrap justify-content-between align-items-center mt-4 pt-3 border-top">
          <a href="/nhanVien" class="btn" id="btnTroVe">
            <i class="bi bi-arrow-left me-1"></i> Trở Về Danh Sách
          </a>
          <a href="/updateNV/<%= value.id_User %>" class="btn" id="btnSuaNV">
            <i class="bi bi-pencil-square me-1"></i> Chỉnh Sửa Nhân Viên Này
          </a>
        </div>
      </form>
    </div>
  </div>

  <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

  <!-- Phần phân quyền hiển thị tên người dùng trên header -->
  <script>
    window.onload = function () {
      const TenNhanVien = localStorage.getItem("TenNhanVien");
      const Role = localStorage.getItem("userRole");

      if (TenNhanVien) {
        const fullnameEl = document.querySelector(".fullname");
        if (fullnameEl) {
          fullnameEl.innerText = `${TenNhanVien} - ${Role}`;
        }
      } else {
        const fullnameEl = document.querySelector(".fullname");
        if (fullnameEl) {
          fullnameEl.innerText = "Hi, Guest";
        }
      }
    };
  </script>
</body>
</html>
