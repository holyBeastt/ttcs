<!DOCTYPE html>
<html lang="vi">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Vượt Giờ V2 - <%= typeof pageTitle !== 'undefined' ? pageTitle : (statsScope === 'PREVIEW' ? 'Thống kê coi, chấm thi, ra đề dự kiến' : 'Thống kê coi, chấm thi, ra đề chính thức') %></title>

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
  <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.6.16/dist/sweetalert2.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="/css/admin.css" />
  <link rel="stylesheet" href="/css/styles.css" />
  <link rel="stylesheet" href="/css/nckh_v3_stats.css" />
  <style>
    .badge-approved {
      background-color: #d1fae5;
      color: #065f46;
      border: 1px solid #a7f3d0;
      padding: 4px 8px;
      border-radius: 6px;
      font-size: 0.8rem;
      font-weight: 600;
    }
    .badge-pending {
      background-color: #fef3c7;
      color: #92400e;
      border: 1px solid #fde68a;
      padding: 4px 8px;
      border-radius: 6px;
      font-size: 0.8rem;
      font-weight: 600;
    }
    .type-badge-coi {
      background-color: #e0f2fe;
      color: #0369a1;
      font-weight: 600;
      padding: 3px 8px;
      border-radius: 4px;
    }
    .type-badge-rade {
      background-color: #fef3c7;
      color: #b45309;
      font-weight: 600;
      padding: 3px 8px;
      border-radius: 4px;
    }
    .type-badge-cham {
      background-color: #fce7f3;
      color: #be185d;
      font-weight: 600;
      padding: 3px 8px;
      border-radius: 4px;
    }
    .kthp-hours-tag {
      display: inline-block;
      margin-left: 8px;
      background: rgba(79, 70, 229, 0.1);
      color: #4f46e5;
      padding: 2px 10px;
      border-radius: 12px;
      font-size: 0.82rem;
      font-weight: 600;
    }
    .kthp-badge-sub {
      display: inline-block;
      margin-left: 6px;
      background: #f1f5f9;
      color: #475569;
      padding: 2px 8px;
      border-radius: 10px;
      font-size: 0.78rem;
    }
  </style>
</head>

<body class="<%= statsScope === 'PREVIEW' ? 'nckh-preview-stats' : '' %>">
  <%- include('../header') %>

  <div class="stats-wrap">
    <div class="stats-page-header">
      <h1 class="stats-page-title">
        <span class="title-icon"><i class="bi bi-bar-chart-line"></i></span>
        <%= typeof pageTitle !== 'undefined' ? pageTitle : (statsScope === 'PREVIEW' ? 'Thống kê coi, chấm thi, ra đề dự kiến' : 'Thống kê coi, chấm thi, ra đề chính thức') %>
      </h1>
      <nav class="stats-nav" aria-label="Các loại thống kê coi, chấm thi, ra đề">
        <button type="button" class="nav-pill active" data-stat-tab="lecturer"><i class="bi bi-person"></i> Theo giảng viên</button>
        <button type="button" class="nav-pill" data-stat-tab="faculty"><i class="bi bi-building"></i> Theo khoa/phòng</button>
        <button type="button" class="nav-pill" data-stat-tab="institute"><i class="bi bi-bank"></i> Theo học viện</button>
      </nav>
    </div>

    <div class="stats-toolbar">
      <div class="tb-group" id="kthpNamHocFromGroup">
        <label for="kthpNamHocFrom">Từ năm học</label>
        <select id="kthpNamHocFrom" class="form-select"></select>
      </div>
      <div class="tb-group" id="kthpNamHocToGroup">
        <label for="kthpNamHocTo">Đến năm học</label>
        <select id="kthpNamHocTo" class="form-select"></select>
      </div>
      <div class="tb-group" id="kthpKhoaGroup">
        <label for="kthpKhoaFilter">Khoa / Phòng ban</label>
        <select id="kthpKhoaFilter" class="form-select">
          <option value="ALL">Tất cả khoa</option>
        </select>
      </div>
      <div class="tb-group" id="kthpLoaiGroup">
        <label for="kthpLoaiFilter">Loại công việc</label>
        <select id="kthpLoaiFilter" class="form-select">
          <option value="ALL">Tất cả loại</option>
          <option value="COI_THI">Coi thi</option>
          <option value="RA_DE">Ra đề thi</option>
          <option value="CHAM_THI">Chấm thi</option>
        </select>
      </div>
      <div class="tb-group" id="kthpKeywordGroup" style="min-width: 250px;">
        <label for="kthpKeywordInput">Tìm giảng viên</label>
        <input id="kthpKeywordInput" class="form-control" list="kthpLecturerSuggestions" autocomplete="off" placeholder="Nhập tên giảng viên..." />
        <datalist id="kthpLecturerSuggestions"></datalist>
      </div>
      <div class="tb-actions">
        <button id="kthpLoadBtn" class="btn btn-load"><i class="bi bi-search"></i> Hiển thị</button>
        <button id="kthpExportBtn" class="btn btn-export"><i class="bi bi-file-earmark-excel"></i> Xuất Excel</button>
      </div>
    </div>

    <div class="stats-kpi-row" id="kthpKpiRow">
      <div class="stats-kpi-card">
        <div class="kpi-icon"><i class="bi bi-people"></i></div>
        <div class="kpi-label" id="kthpKpiLabel1">Giảng viên</div>
        <div class="kpi-value" id="kthpKpiValue1">0</div>
      </div>
      <div class="stats-kpi-card">
        <div class="kpi-icon"><i class="bi bi-clock-history"></i></div>
        <div class="kpi-label">Tổng số tiết QC</div>
        <div class="kpi-value" id="kthpKpiValue2">0</div>
      </div>
      <div class="stats-kpi-card">
        <div class="kpi-icon"><i class="bi bi-card-checklist"></i></div>
        <div class="kpi-label" id="kthpKpiLabel3">Tổng lượt/công việc</div>
        <div class="kpi-value" id="kthpKpiValue3">0</div>
      </div>
    </div>

    <% if (typeof showChart !== 'undefined' && showChart) { %>
    <!-- Biểu đồ thống kê (Chỉ hiển thị ở mục Thống Kê - bản ghi duyệt 2 lần) -->
    <div class="row g-3 mb-4" id="kthpChartSection" style="display: none;">
      <div class="col-lg-7">
        <div class="stats-chart-card">
          <div class="stats-chart-header">
            <h6 class="stats-chart-title" id="kthpChartTitle1">
              <i class="bi bi-bar-chart-fill me-2"></i>Biểu đồ thống kê
            </h6>
          </div>
          <div class="stats-chart-body">
            <canvas id="kthpChart1"></canvas>
          </div>
        </div>
      </div>
      <div class="col-lg-5">
        <div class="stats-chart-card">
          <div class="stats-chart-header">
            <h6 class="stats-chart-title" id="kthpChartTitle2">
              <i class="bi bi-pie-chart-fill me-2"></i>Phân bổ tỉ lệ
            </h6>
          </div>
          <div class="stats-chart-body stats-chart-body--doughnut">
            <canvas id="kthpChart2"></canvas>
          </div>
        </div>
      </div>
    </div>
    <% } %>

    <div id="kthpContent"></div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.6.16/dist/sweetalert2.all.min.js"></script>
  <% if (typeof showChart !== 'undefined' && showChart) { %>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
  <% } %>
  <script>
    window.KTHP_STATS_SCOPE = <%- JSON.stringify(statsScope || "OFFICIAL") %>;
    window.KTHP_SHOW_CHART = <%- JSON.stringify(Boolean(typeof showChart !== 'undefined' && showChart)) %>;
  </script>
  <script src="/js/vuotgio_v2/kthpStats/index.js"></script>
</body>

</html>

