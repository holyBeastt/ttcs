        const Home = document.getElementById("Home");

        Home.addEventListener("click", function (event) {
          event.preventDefault(); // Ngăn chặn hành vi mặc định của liên kết

          const isKhoa = localStorage.getItem("isKhoa");

          if (isKhoa == 0) {
            // Nếu là đào tạo hoặc tài chính
            window.location.href = "/maindt";
          } else {
            window.location.href = "/mainkhoa";
          }
        });

        ///
        const role = localStorage.getItem("userRole");
        const MaPhongBan = localStorage.getItem("MaPhongBan");
        const isKhoa = localStorage.getItem("isKhoa");

        // Nếu là phòng ban thì hiện lọc theo khoa
        if (isKhoa == 0) {
          document.getElementById("filterKhoa").style.display = "block";
        }

        if (role == APP_ROLES.thuong || role.includes(APP_ROLES.gv_khoa)) {
          // Ẩn tất cả các cột
          document.getElementById("checkAllKhoa").disabled = true;
          document.getElementById("checkAllDaoTao").disabled = true;
          document.getElementById("checkAllVP").disabled = true;

          if (!role.includes("CNBM")) {
            document.getElementById("update-qc").style.display = "none";
          }
        }

        if (isKhoa == 1 && role == APP_ROLES.lanhDao_khoa) {
          document.getElementById("checkAllDaoTao").disabled = true;
          document.getElementById("checkAllVP").disabled = true;

          document.getElementById("checkAllKhoa").disabled = false;
        } else if (isKhoa == 0 && (role == APP_ROLES.troLy_phong || role == APP_ROLES.lanhDao_phong)) {
          if (MaPhongBan == APP_DEPARTMENTS.daoTao) {
