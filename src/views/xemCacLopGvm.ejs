    <script>
      $(document).ready(async function () {
        await init();
      });

      async function init() {
        showSuggestionsBoMonHead(); // Hiển thị gợi ý bộ môn
        showSuggestionsKhoaHead();
      }

      function showSuggestionsBoMonHead() {
        $("#filterBoMon").autocomplete({
          source: function (request, response) {
            const value = request.term.toLowerCase();
            const khoaValue = $("#filterKhoa").val() || "";
            let boMon = JSON.parse(localStorage.getItem("boMon") || "[]");
            if (!Array.isArray(boMon)) boMon = [];

            let suggestions = boMon
              .filter(
                (item) => khoaValue === "" || item.MaPhongBan === khoaValue
              )
              .map(
                (item) =>
                  `${item.MaPhongBan} - ${item.TenBoMon} - ${item.MaBoMon}`
              );

            if (value) {
              suggestions = suggestions.filter((name) =>
                name.toLowerCase().includes(value)
              );
            }

            response(suggestions);
          },
          minLength: 0,
          delay: 300, // Thêm độ trễ
          select: function (event, ui) {
            let parts = ui.item.value.split("-").map((p) => p.trim());
            let processedName = parts.slice(2).join(" - ");
            $("#filterBoMon").val(processedName);
            filterBoMon();
            return false;
          },
        });

        $("#filterBoMon").on("focus", function () {
          $(this).autocomplete("search", "");
        });
      }

      // Định nghĩa hàm showSuggestionsKhoa ở phạm vi toàn cục
      function showSuggestionsKhoaHead() {
        $("#filterKhoa").autocomplete({
          source: function (request, response) {
            const value = request.term.toLowerCase();
            let phongBanList = JSON.parse(
              localStorage.getItem("phongBanList") || "[]"
            );
            if (!Array.isArray(phongBanList)) phongBanList = [];

            let suggestions = phongBanList.map(
              (item) => `${item.MaPhongBan} - ${item.TenPhongBan}`
            );

            if (value) {
              suggestions = suggestions.filter((name) =>
                name.toLowerCase().includes(value)
              );
            }

            response(suggestions);
          },
          minLength: 0,
          delay: 300, // Thêm độ trễ
          select: function (event, ui) {
            let parts = ui.item.value.split("-");
            let processedName = parts[0].trim();
            $("#filterKhoa").val(processedName);
            filterKhoa();
            return false;
          },
        });

        $("#filterKhoa").on("focus", function () {
          $(this).autocomplete("search", "");
        });
      }

      function filterKhoa() {
        const input = document.getElementById("filterKhoa");
        const filter = input.value.toLowerCase();
        const tableRows = document.querySelectorAll("#tableBody tr");

        // Nếu ô tìm kiếm trống, hiển thị tất cả các dòng
        if (!filter) {
          tableRows.forEach((row) => {
            row.style.display = ""; // Hiện tất cả các dòng
          });
          return;
        }

        // Chỉ hiện các dòng có tên giảng viên khớp với giá trị tìm kiếm
        tableRows.forEach((row) => {
          const nameCell = row.querySelector("td:nth-child(6)"); // Giả sử tên giảng viên nằm ở cột thứ 5
          const name = nameCell.textContent.toLowerCase();

          if (name.includes(filter)) {
            row.style.display = ""; // Hiện hàng nếu khớp
          } else {
            row.style.display = "none"; // Ẩn hàng nếu không khớp
          }
        });
        calculateTotals();
      }

      // Bây giờ bọc phần còn lại của mã trong DOMContentLoaded
      document.addEventListener("DOMContentLoaded", function () {
        // Hàm filterKhoa (giữ nguyên)
        function filterKhoa() {
          const input = document.getElementById("filterKhoa");
          const filter = input.value.toLowerCase();
          const tableRows = document.querySelectorAll("#tableBody tr");

          if (!filter) {
            tableRows.forEach((row) => {
              row.style.display = ""; // Hiện tất cả các dòng
            });
            return;
          }

          tableRows.forEach((row) => {
            const nameCell = row.querySelector("td:nth-child(6)");
            const name = nameCell.textContent.toLowerCase();
            row.style.display = name.includes(filter) ? "" : "none";
          });
          calculateTotals();
        }
      });
    </script>
    <script>
      document
        .getElementById("infome")
        .addEventListener("click", function (event) {
          event.preventDefault(); // Ngăn chặn hành vi mặc định của thẻ a
          const id_User = localStorage.getItem("id_User"); // Lấy id_User từ localStorage\
          if (id_User) {
            // Chuyển hướng đến trang infome và truyền id_User trong URL
            window.location.href = `/infome/${id_User}`;
          } else {
            alert("Không tìm thấy id_User trong localStorage.");
          }
        });
    </script>

