    <!-- sort theo các số tiết -->
    <script>
      // Thêm chức năng sort cho cột "Tổng số tiết cả năm"
      document.addEventListener("DOMContentLoaded", function () {
        const headers = document.querySelectorAll("th");

        // Tìm index của cột "Tổng số tiết cả năm"
        let totalYearlyLessonsIndex = -1;

        headers.forEach((header, index) => {
          if (header.textContent.trim() === "Tổng số tiết cả năm") {
            totalYearlyLessonsIndex = index;
            header.classList.add("sortable");
            header.dataset.sortDirection = "none";
            header.style.cursor = "pointer";
            header.innerHTML += ' <span class="sort-icon">&#8597;</span>';

            header.addEventListener("click", function () {
              sortTableByGroupedRows(totalYearlyLessonsIndex);
              updateSortIcon(this);
            });
          }
        });
      });

      // Hàm sort bảng theo nhóm rows (xử lý rowspan)
      function sortTableByGroupedRows(colIndex) {
        const table = document.querySelector("table");
        const tbody = table.querySelector("tbody");
        const header = table.querySelectorAll("th")[colIndex];

        // Xác định hướng sort
        const currentDirection = header.dataset.sortDirection;
        const newDirection = currentDirection === "asc" ? "desc" : "asc";
        header.dataset.sortDirection = newDirection;

        // Lấy tất cả các dòng đầu tiên của mỗi nhóm (dòng có rowspan)
        const rowGroups = [];
        const allRows = Array.from(tbody.querySelectorAll("tr"));

        // Tìm tất cả các dòng đầu của nhóm (những dòng có rowspan ở cột Tổng số tiết cả năm)
        let i = 0;
        while (i < allRows.length) {
          const row = allRows[i];
          const cell = row.cells[colIndex];

          if (cell && cell.hasAttribute("rowspan")) {
            // Đây là dòng đầu của một nhóm
            const rowspan = parseInt(cell.getAttribute("rowspan"));
            const group = {
              headRow: row,
              value: parseFloat(cell.textContent.trim()) || 0,
              rowspan: rowspan,
              rows: [row],
            };

            // Thêm các dòng tiếp theo vào nhóm
            for (let j = 1; j < rowspan && i + j < allRows.length; j++) {
              group.rows.push(allRows[i + j]);
            }

            rowGroups.push(group);
            i += rowspan;
          } else {
            // Dòng đơn lẻ hoặc một phần của nhóm đã được xử lý
            i++;
          }
        }

        // Sort các nhóm dòng theo giá trị của cột "Tổng số tiết cả năm"
        rowGroups.sort((a, b) => {
          if (newDirection === "asc") {
            return a.value - b.value;
          } else {
            return b.value - a.value;
          }
        });

        // Xóa tất cả các dòng khỏi tbody
        while (tbody.firstChild) {
          tbody.removeChild(tbody.firstChild);
        }

        // Thêm lại các dòng theo thứ tự đã sort
        let sttCounter = 1;
        rowGroups.forEach((group) => {
          // Cập nhật STT cho nhóm
          const firstCell = group.headRow.cells[0];
          if (firstCell && firstCell.hasAttribute("rowspan")) {
            firstCell.textContent = sttCounter;
            sttCounter++;
          }

          // Thêm tất cả các dòng của nhóm vào tbody
          group.rows.forEach((row) => {
            tbody.appendChild(row);
          });
        });
      }

      // Cập nhật biểu tượng sort
      function updateSortIcon(header) {
        const icon = header.querySelector(".sort-icon");
        if (header.dataset.sortDirection === "asc") {
          icon.innerHTML = "&#9650;"; // Mũi tên lên
        } else {
          icon.innerHTML = "&#9660;"; // Mũi tên xuống
        }
      }
    </script>
    <!-- Phân quyền -->
    <script>
      var MaPhongBan = localStorage.getItem("MaPhongBan");
      var isKhoa = localStorage.getItem("isKhoa");

      //const role = localStorage.getItem("userRole");

      document.addEventListener("DOMContentLoaded", () => {
        // Ẩn phần lọc khoa nếu role là Khoa
        const departmentFilter = document.getElementById("departmentFilter");

        if (!MaPhongBan.includes(APP_DEPARTMENTS.daoTao) && !MaPhongBan.includes(APP_DEPARTMENTS.vanPhong)) {
          departmentFilter.style.display = "none";
        }

        loadHeMoiGiangToSelect();
      });

      async function loadHeMoiGiangToSelect() {
        try {
          const res = await fetch('/api/gvm/v1/he-moi-giang');
          const json = await res.json();

          if (!json.success) {
            console.error('API lỗi');
            return;
          }

          const select = document.getElementById('he_dao_tao');
          if (!select) return;

          // clear option cũ (nếu cần reload)
          select.innerHTML = '';

          const allOption = document.createElement('option');
          allOption.value = '0';   // hoặc '' hoặc -1 tuỳ backend m xử lý
          allOption.textContent = 'Tất cả hệ';
          select.appendChild(allOption);

          json.data.forEach(item => {
            const option = document.createElement('option');
            option.value = item.id;
            option.textContent = item.he_dao_tao;
            select.appendChild(option);
          });

        } catch (err) {
          console.error('Lỗi load hệ đồ án:', err);
        }
      }
    </script>

    <script>
      function filterTable() {
        // Lấy giá trị lọc từ các dropdown
        let dot = document.getElementById("combobox-dot").value;
        let ki = document.getElementById("combobox-ki").value;
        let nam = document.getElementById("NamHoc").value;
        let department = document
          .getElementById("departmentFilter")
          .value.trim();
        const he_dao_tao = document.getElementById("he_dao_tao").value;

        // Nếu là Khoa thì gắn lại department = MaPhongBan
        if (isKhoa == 1) {
          department = MaPhongBan;
        }

        // Tạo dữ liệu gửi đến server
        const filterData = {
          dot: dot,
          ki: ki,
          nam: nam,
          department: department,
          he_dao_tao: he_dao_tao,
        };

        // Gửi request tới server để lấy dữ liệu lọc
        fetch("/api/moi-giang/v1/getClassInfoGvmData", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify(filterData),
        })
          .then((response) => response.json())
          .then((response) => {
            // Render lại bảng dựa trên dữ liệu trả về từ server
            if (response.data && response.dinhMuc) {
                 renderTable(response.data, response.dinhMuc);
            } else {
                 // Nếu không đúng cấu trúc mới, thử render trực tiếp (cho trường hợp cũ hoặc lỗi)
                 // Nhưng không truyền fallback cứng
                 renderTable(response);
            }
          })
          .catch((error) => {
            console.error("Error fetching data:", error);
          });
      }

      function renderTable(data, dinhMuc) {
        // Nếu không có định mức được truyền vào, có thể set mặc định là 0 hoặc handle tuỳ ý,
        // nhưng theo yêu cầu user là bỏ fallback gây nhầm lẫn.
        // Ta sẽ gán dinh muc mac dinh la 0 neu khong co.
        if (!dinhMuc) {
             dinhMuc = { normal: 0, nghiHuu: 0 };
        }
        
        // Hiển thị thông tin định mức
        const limitInfoDiv = document.getElementById("limitInfo");
        if (dinhMuc.normal > 0 || dinhMuc.nghiHuu > 0) {
            limitInfoDiv.textContent = `Định mức tiết dạy: ${dinhMuc.normal} tiết (Giảng viên chưa nghỉ hưu), ${dinhMuc.nghiHuu} tiết (Giảng viên đã nghỉ hưu)`;
            limitInfoDiv.style.display = "block";
        } else {
            limitInfoDiv.style.display = "none";
        }

        console.log(data);
        const tableBody = document.getElementById("data-table-body");
        tableBody.innerHTML = ""; // Clear previous data

        let index = 1;

        // Duyệt qua tất cả các giảng viên trong groupedByTeacher
        // Giả sử biến "index" và "tableBody" đã được khai báo từ trước

        Object.keys(data).forEach((teacher) => {
          const courses = data[teacher];

          // Tính tổng số tiết của tất cả các khóa học (bao gồm cả khóa học cuối cùng)
          const totalSoTiet = qcDisplay.sum(
            courses.map((course) => course.SoTiet)
          );

          // Lấy đối tượng cuối cùng của mảng để tính tổng tiết trong năm, không render nó ra bảng
          const lastCourse = courses[courses.length - 1];
          const tongSoTietBaoGomDoAn = Number.parseFloat(
            lastCourse.tongSoTietBaoGomDoAn == 0
              ? totalSoTiet
              : lastCourse.tongSoTietBaoGomDoAn
          );

          // Render bảng chỉ với các phần tử từ đầu đến phần tử áp chót (bỏ qua đối tượng cuối cùng)
          courses.slice(0, -1).forEach((course, courseIndex) => {
            const tr = document.createElement("tr");
            tr.setAttribute("data-department", course.Khoa);
            tr.setAttribute("data-dot", course.Dot);
            tr.setAttribute("data-ki", course.KiHoc);
            tr.setAttribute("data-nam", course.NamHoc);

            // Nếu là khóa học đầu tiên của giảng viên, thêm thông tin giảng viên với rowspan
            if (courseIndex === 0) {
              tr.classList.add("teacher-group");

              // Nếu chưa duyệt thì thêm dòng “⏳ Chưa duyệt”
              const duyetText = course.hoc_vien_duyet === 0 ? `<div title="Chưa được duyệt bởi học viện" style="font-size: 12px; margin-top: 3px; color: #8a4fff; font-weight: 600;">⏳ Chưa duyệt</div>` : "";

              // Nếu đã nghỉ hưu thì thêm dòng “🏖️ Đã nghỉ hưu
              const nghiHuuText = course.isNghiHuu == 1 ? `<div title="Giảng viên đã nghỉ hưu" style="font-size: 12px; margin-top: 3px; color: #ff4a4a; font-weight: 600;">🏖️ Đã nghỉ hưu</div>` : "";

              debugger
              tr.innerHTML = `
                <td rowspan="${courses.length - 1}">${index}</td>
                <td rowspan="${courses.length - 1}">
                  ${course.GiangVien}<br>(GVM ${course.MaPhongBan})
                  ${duyetText}
                  ${nghiHuuText}
                </td>
              `;
              index++;
            }



            // Xác định định mức cho giảng viên hiện tại
            // Dùng courses[0] vì lastCourse là object tổng hợp do backend đẩy vào, có thể thiếu thông tin isNghiHuu
            let limit = dinhMuc.normal;
            if (courses[0] && courses[0].isNghiHuu == 1) {
                limit = dinhMuc.nghiHuu;
            }

            if (Number.parseFloat(tongSoTietBaoGomDoAn) > limit) {
              tr.classList.add("alert-sotiet");
            }

            // Thêm các ô dữ liệu cho môn học
            tr.innerHTML += `
            <td>${course.TenHocPhan}</td>
            <td>${course.Lop}</td>
            <td>${course.SoTinChi}</td>
            <td>${course.Dot}</td>
            <td>${course.KiHoc}</td>
            <td>${course.NamHoc}</td>
            <td>${formatDate(course.NgayBatDau)}</td>
            <td>${formatDate(course.NgayKetThuc)}</td>
            <td>${course.SoTiet}</td>
          `;

            // Nếu là khóa học đầu tiên của giảng viên, thêm thông tin tổng số tiết, phòng ban và nút xem chi tiết
            if (courseIndex === 0) {
              tr.innerHTML += `
        <td rowspan="${courses.length - 1}">${totalSoTiet}</td>
        <td rowspan="${courses.length - 1}">${tongSoTietBaoGomDoAn}</td>
        <td rowspan="${courses.length - 1}">${course.Khoa}</td>
        <td rowspan="${courses.length - 1}">
          <button class="action-button view" onclick="viewClass(this, '${
            parseInt(course.id_Gvm) - 1
          }')">👁️</button>
        </td>
      `;
            }
            tableBody.appendChild(tr);
          });
        });

        calculateTotals();
      }

      // Hàm format ngày tháng
      function formatDate(dateStr) {
        if (!dateStr) return "N/A";
        const date = new Date(dateStr);
        if (isNaN(date.getTime())) return "N/A";
        const day = String(date.getDate()).padStart(2, "0");
        const month = String(date.getMonth() + 1).padStart(2, "0");
        const year = date.getFullYear();
        return `${day}/${month}/${year}`;
      }

      // Giả sử GiangDay đã được định nghĩa trước đó
      renderTable(GiangDay);
    </script>

    <script>
      document.addEventListener("DOMContentLoaded", function () {
        const qcValues = [];
        // console.log(totalQC)

        // Chọn tất cả các hàng chứa dữ liệu
        const rows = document.querySelectorAll(
          "tbody.teacher-group tr[data-department]"
        );

        rows.forEach((row) => {
          // Kiểm tra xem hàng có hiển thị hay không
          const isVisible = row.style.display != "none";

          if (isVisible) {
            // Lấy ô QuyChuan theo thứ tự cột (giả định cột QuyChuan là cột thứ 10)
            const qcCell = row.querySelector("td:nth-child(12)");
