<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Học Viện Kỹ Thuật Mật Mã</title>
  <link rel="stylesheet" href="/css/table.css">
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/css/styles.css">

  <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>

<body>
  <%- include('adminHeader') %>

  <div class="container my-5 box">
        <form class="d-flex align-items-end mb-3" action="/namHoc" method="post">
            <div>
                <label for="NamHoc">Năm Học</label>
                <input class="form-control" type="text" id="NamHoc" name="NamHoc"> 
            </div>
            <button id="createNM" class="btn mx-5" style="margin: 0;height: 36px;">
                <i class="bi bi-plus-circle"></i> Thêm Năm Học
            </button>
        </form>
        <!-- Nút Lọc màu giống nút Hiển thị -->

      <div class="pb-3">
        <table id="NamHocTable" class="table table-bordered">
          <thead>
            <tr>
              <th>Năm học</th>
              <th>Trạng thái</th>
              <th>Thao tác</th>
            </tr>
          </thead>
          <tbody id="data-table-body">
            <% if (NamHoc && NamHoc.length > 0) { %>
              <% for (var i = 0; i < NamHoc.length; i++) { %>
                <tr>
                  <td><%= NamHoc[i].NamHoc %></td>
                  <td>
                    <div class="form-check form-switch">
                      <input class="form-check-input nam-hoc-status-toggle"
                          type="checkbox"
                          role="switch"
                          data-nam-hoc="<%= NamHoc[i].NamHoc %>"
                          onchange="updateNamHocStatus(this)"
                          <%= Number(NamHoc[i].trangthai) === 1 ? 'checked disabled' : '' %>>
                      <label class="form-check-label">
                        <%= Number(NamHoc[i].trangthai) === 1 ? 'Mặc định' : 'Đặt mặc định' %>
                      </label>
                    </div>
                  </td>
                  <td class="d-flex" style="border: none;">
                    <button class="bi bi-trash3 action-button edit"
                        onclick="deleteNamHoc(this, '<%= NamHoc[i].NamHoc %>')">
                      </button>
                  </td>
                </tr>
              <% } %>
            <% } else { %>
            <% } %>
          </tbody>
        </table>
      </div>
  </div>
  <script>
    async function deleteNamHoc(button, NamHoc) {
      const result = await Swal.fire({
        title: "Xóa năm học?",
        text: `Bạn có chắc muốn xóa năm học ${NamHoc} không?`,
        icon: "warning",
        showCancelButton: true,
        confirmButtonText: "Xóa",
        cancelButtonText: "Hủy",
        confirmButtonColor: "#dc3545",
      });

      if (!result.isConfirmed) return;

      try {
        const response = await fetch(`/namHoc/${encodeURIComponent(NamHoc)}`, {
          method: "DELETE",
          headers: { "Content-Type": "application/json" },
        });
        const data = await response.json().catch(() => ({}));

        if (!response.ok) {
          throw new Error(data.message || "Không thể xóa năm học.");
        }

        await Swal.fire({
          title: "Đã xóa",
          text: "Năm học đã được xóa thành công.",
          icon: "success",
          timer: 1400,
          showConfirmButton: false,
        });
        button.closest("tr").remove();
      } catch (error) {
        Swal.fire({
          title: "Không thể xóa",
          text: error.message,
          icon: "error",
          confirmButtonText: "Đã hiểu",
        });
      }
    }
  </script>
<script>
  async function updateNamHocStatus(button) {
    const NamHoc = button.dataset.namHoc;

    const result = await Swal.fire({
      title: "Đổi năm mặc định?",
      text: `Năm học ${NamHoc} sẽ trở thành năm mặc định của hệ thống.`,
      icon: "question",
      showCancelButton: true,
      confirmButtonText: "Đổi năm",
      cancelButtonText: "Hủy",
      confirmButtonColor: "#0d6efd",
    });

    if (!result.isConfirmed) {
      button.checked = false;
      return;
    }

    button.disabled = true;

    try {
      const response = await fetch(`/namHoc/${encodeURIComponent(NamHoc)}/status`, {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
      });
      const data = await response.json();

      if (!response.ok || !data.success) {
        throw new Error(data.message || "Cập nhật trạng thái thất bại.");
      }

      await Swal.fire({
        title: "Đã cập nhật",
        text: data.message,
        icon: "success",
        timer: 1400,
        showConfirmButton: false,
      });
      window.location.reload();
    } catch (error) {
      button.checked = false;
      button.disabled = false;
      Swal.fire({
        title: "Cập nhật thất bại",
        text: error.message,
        icon: "error",
        confirmButtonText: "Đã hiểu",
      });
    }
  }
</script>
<script>
  document.getElementById("changePasswordLink").addEventListener("click", function(event) {
event.preventDefault(); // Ngăn chặn hành vi mặc định của thẻ a
const tenDangNhap = localStorage.getItem("TenDangNhap"); // Lấy TenDangNhap từ localStorage

if (tenDangNhap) {
    // Chuyển hướng đến trang changePassword và truyền TenDangNhap trong URL
    window.location.href = `/changePassword?tenDangNhap=${encodeURIComponent(tenDangNhap)}`;
} else {
    Swal.fire({
      title: "Không tìm thấy tài khoản",
      text: "Vui lòng đăng nhập lại để đổi mật khẩu.",
      icon: "warning",
      confirmButtonText: "Đã hiểu",
    });
}
});
</script>
</body>

</html>
