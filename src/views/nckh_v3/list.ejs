<!DOCTYPE html>
<html lang="vi">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>NCKH V3 - Xem chung</title>

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" />
  <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.6.16/dist/sweetalert2.min.css" rel="stylesheet" />

  <link rel="stylesheet" href="/css/admin.css" />
  <link rel="stylesheet" href="/css/styles.css" />
  <link rel="stylesheet" href="/css/nckh_v3.css" />

  <style>
    .nckh-v3-list-wrap {
      padding: 16px;
      max-width: 1700px;
      margin: 0 auto;
    }

    /* ── Toolbar ── */
    .nckh-v3-list-toolbar {
      display: flex;
      align-items: flex-end;
      gap: 10px;
      flex-wrap: wrap;
      margin-bottom: 16px;
      padding: 12px 14px;
      background: #f8f9fb;
      border: 1px solid #dee2e6;
      border-radius: 8px;
    }

    .nckh-v3-list-toolbar .form-select,
    .nckh-v3-list-toolbar .form-control,
    .nckh-v3-list-toolbar .btn {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }

    .nckh-v3-list-toolbar .toolbar-item {
      min-width: 160px;
    }

    .nckh-v3-list-toolbar .toolbar-item label {
      font-weight: 600;
      margin-bottom: 4px;
      font-size: 0.85rem;
      color: #495057;
      display: block;
    }

    .nckh-v3-list-toolbar .toolbar-item select,
    .nckh-v3-list-toolbar .toolbar-item input {
      height: 38px;
      font-size: 0.875rem;
    }

    .nckh-v3-list-toolbar .toolbar-action {
      display: flex;
      align-items: flex-end;
      gap: 6px;
    }

    .nckh-v3-list-toolbar .toolbar-action button {
      height: 38px;
      min-width: 100px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      line-height: 1.2;
      font-size: 0.85rem;
      gap: 5px;
    }

    /* ── Table container ── */
    .nckh-v3-list-table {
      width: 100%;
      overflow-x: auto;
      border: 1px solid #d0d5dd;
      border-radius: 8px;
    }

    .nckh-v3-list-table table {
      margin-bottom: 0;
      min-width: 1400px;
      border-collapse: separate;
      border-spacing: 0;
      width: 100%;
    }

    /* ── Header ── */
    .nckh-v3-list-table thead th {
      background: #edf0f5;
      color: #344054;
      font-weight: 700;
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 0.02em;
      vertical-align: middle;
      white-space: nowrap;
      padding: 10px 8px;
      border-bottom: 2px solid #c5ccd6;
      border-right: 1px solid #d8dde4;
      position: sticky;
      top: 0;
      z-index: 2;
    }

    .nckh-v3-list-table thead th:last-child {
      border-right: none;
    }

    /* ── Body cells ── */
    .nckh-v3-list-table td {
      vertical-align: middle;
      padding: 7px 8px;
      font-size: 0.85rem;
      border-bottom: 1px solid #e4e7ec;
      border-right: 1px solid #eef0f4;
      color: #344054;
    }

    .nckh-v3-list-table td:last-child {
      border-right: none;
    }

    .nckh-v3-list-table tbody tr:last-child td {
      border-bottom: none;
    }

    /* ── Row hover ── */
    .nckh-v3-list-table tbody tr {
      transition: background-color 0.15s ease;
    }

    .nckh-v3-list-table tbody tr:hover {
      background-color: #e8f0fe;
    }

    /* ── Row stripe (subtle) ── */
    .nckh-v3-list-table tbody tr:nth-child(even) {
      background-color: #fafbfc;
    }
    .nckh-v3-list-table tbody tr:nth-child(even):hover {
      background-color: #e8f0fe;
    }

    .nckh-v3-list-table .col-main {
      min-width: 240px;
    }

    .nckh-v3-list-table .col-people {
      white-space: nowrap;
    }

    /* ── Action buttons in table: icon-only, compact ── */
    .nckh-v3-list-table .btn-action {
      width: 30px;
      height: 30px;
      padding: 0;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 6px;
      font-size: 0.85rem;
      transition: all 0.15s ease;
    }

    .nckh-v3-list-table .btn-action:hover:not(:disabled) {
      transform: scale(1.12);
    }

    .nckh-v3-list-table .col-actions {
      white-space: nowrap;
      text-align: center;
      width: 80px;
    }

    .nckh-v3-person-row {
      display: block;
      white-space: nowrap;
      line-height: 1.35;
    }

    .nckh-v3-person-row + .nckh-v3-person-row {
      margin-top: 2px;
    }

    .nckh-v3-checkbox {
      width: 17px;
      height: 17px;
      cursor: pointer;
      accent-color: #4361ee;
    }

    .nckh-v3-checkbox:disabled {
      cursor: not-allowed;
      opacity: 0.45;
    }

    /* ── Sortable header cursor ── */
    th.sortable {
      cursor: pointer;
      user-select: none;
    }
    th.sortable:hover {
      background-color: #dfe4ed !important;
    }

    /* ── Record count badge ── */
    .nckh-v3-record-count {
      font-size: 0.82rem;
      color: #667085;
      padding: 6px 0 0;
    }

    /* ── Group header row ── */
    .nckh-v3-group-header td {
      background: #dce4f0 !important;
      font-size: 0.85rem;
      padding: 8px 12px !important;
      text-align: left !important;
      border-bottom: 2px solid #b8c5d9 !important;
      color: #1d2939;
      letter-spacing: 0.01em;
    }

    .nckh-v3-group-header:hover td {
      background: #d0d9ea !important;
    }

    .nckh-v3-group-count {
      display: inline-block;
      background: #4361ee;
      color: #fff;
      font-size: 0.72rem;
      font-weight: 700;
      padding: 1px 8px;
      border-radius: 10px;
      margin-left: 8px;
      vertical-align: middle;
    }

    /* ── Detail/edit modal ── */
    .nckh-v3-swal-popup {
      width: min(1100px, calc(100vw - 24px)) !important;
      min-height: min(680px, calc(100vh - 24px));
      max-height: calc(100vh - 16px);
      padding: 0 0 18px !important;
      border-radius: 14px !important;
      overflow: hidden;
    }

    .nckh-v3-swal-popup .swal2-title {
      margin: 0 !important;
      padding: 18px 24px 14px;
      color: #1d2939;
      font-size: 1.18rem;
      font-weight: 700;
      text-align: left;
      border-bottom: 1px solid #eaecf0;
    }

    .nckh-v3-swal-popup .swal2-html-container {
      width: 100%;
      margin: 0 !important;
      padding: 18px 24px 0 !important;
      overflow: visible;
      text-align: left;
    }

    .nckh-v3-swal-popup .swal2-html-container,
    .nckh-v3-swal-popup .swal2-html-container * {
      box-sizing: border-box;
    }

    .nckh-detail-content {
      max-height: calc(100vh - 155px);
      overflow-y: auto;
      padding-right: 4px;
    }

    .nckh-detail-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
      margin-bottom: 16px;
    }

    .nckh-detail-item {
      min-width: 0;
      padding: 10px 12px;
      background: #f8fafc;
      border: 1px solid #eaecf0;
      border-radius: 8px;
    }

    .nckh-detail-item.is-wide {
      grid-column: 1 / -1;
    }

    .nckh-detail-item.is-full {
      grid-column: 1 / -1;
    }

    .nckh-detail-label {
      display: block;
      margin-bottom: 3px;
      color: #667085;
      font-size: .75rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: .02em;
    }

    .nckh-detail-value {
      color: #1d2939;
      font-size: .92rem;
      line-height: 1.45;
      overflow-wrap: anywhere;
    }

    .nckh-detail-people {
      margin-top: 12px;
      padding: 12px;
      background: #fff;
      border: 1px solid #eaecf0;
      border-radius: 8px;
    }

    .nckh-detail-people-title {
      margin-bottom: 6px;
      color: #344054;
      font-weight: 700;
    }

    .nckh-modal-actions {
      display: flex;
      justify-content: flex-end;
      gap: 8px;
      padding-top: 16px;
      padding-bottom: 2px;
    }

    .nckh-edit-form {
      max-height: calc(100vh - 145px);
      overflow-y: auto;
      padding-right: 4px;
    }

    .nckh-edit-section {
      margin-bottom: 16px;
      padding: 14px;
      background: #f8fafc;
      border: 1px solid #eaecf0;
      border-radius: 10px;
    }

    .nckh-detail-participant-section {
      margin-top: 14px;
      margin-bottom: 0;
    }

    .nckh-edit-section-title {
      display: flex;
      align-items: center;
      gap: 7px;
      margin-bottom: 12px;
      color: #344054;
      font-size: .92rem;
      font-weight: 700;
    }

    .nckh-edit-section-title i {
      color: #4361ee;
    }

    .nckh-edit-form .form-label {
      margin-bottom: 5px;
      color: #475467;
      font-size: .8rem;
    }

    .nckh-edit-form .form-control,
    .nckh-edit-form .form-select {
      min-height: 38px;
      border-color: #d0d5dd;
      font-size: .86rem;
    }

    .nckh-edit-form .form-control:focus,
    .nckh-edit-form .form-select:focus {
      border-color: #4361ee;
      box-shadow: 0 0 0 3px rgba(67, 97, 238, .12);
    }

    /* Reset legacy/global form rules inside this modal. */
    .nckh-v3-swal-popup .nckh-edit-form input:not([type="checkbox"]):not([type="radio"]),
    .nckh-v3-swal-popup .nckh-edit-form select,
    .nckh-v3-swal-popup .nckh-edit-form textarea {
      width: 100% !important;
      min-height: 38px !important;
      padding: 8px 12px !important;
      color: #344054 !important;
      background: #fff !important;
      border: 1px solid #d0d5dd !important;
      border-radius: 8px !important;
      box-shadow: none !important;
      font-family: inherit !important;
      font-size: .86rem !important;
      font-weight: 400 !important;
      letter-spacing: normal !important;
      line-height: 1.35 !important;
      text-align: left !important;
      text-transform: none !important;
    }

    .nckh-v3-swal-popup .nckh-edit-form select {
      cursor: pointer;
      appearance: auto !important;
      background-image: none !important;
    }

    .nckh-v3-swal-popup .nckh-edit-form input:focus,
    .nckh-v3-swal-popup .nckh-edit-form select:focus,
    .nckh-v3-swal-popup .nckh-edit-form textarea:focus {
      outline: none !important;
      border-color: #4361ee !important;
      box-shadow: 0 0 0 3px rgba(67, 97, 238, .12) !important;
    }

    .nckh-v3-swal-popup .nckh-edit-form button {
      min-height: 38px;
      padding: 8px 14px !important;
      border-radius: 8px !important;
      box-shadow: none !important;
      font-family: inherit !important;
      font-size: .85rem !important;
      font-weight: 600 !important;
      letter-spacing: normal !important;
      line-height: 1.2 !important;
      text-transform: none !important;
    }

    .nckh-edit-form .form-control[readonly] {
      color: #667085;
      background: #eef2f6;
    }

    .nckh-modal-actions .btn {
      min-width: 82px;
      min-height: 40px;
      font-weight: 600;
    }

    .nckh-edit-participants {
      max-height: 250px;
      overflow-y: auto;
      padding-right: 3px;
    }

    .nckh-edit-readonly-note {
      margin: -3px 0 9px;
      color: #667085;
      font-size: .78rem;
    }

    .nckh-edit-participant-readonly {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      min-height: 44px;
    }

    .nckh-edit-person-name {
      min-width: 0;
      color: #344054;
      font-size: .88rem;
      overflow-wrap: anywhere;
    }

    .nckh-edit-person-name i {
      margin-right: 6px;
      color: #667085;
    }

    .nckh-edit-person-unit {
      color: #98a2b3;
      font-size: .8rem;
    }

    .nckh-edit-person-role {
      flex: 0 0 auto;
      padding: 4px 9px;
      color: #475467;
      background: #f2f4f7;
      border: 1px solid #eaecf0;
      border-radius: 999px;
      font-size: .75rem;
      white-space: nowrap;
    }

    .nckh-edit-participant {
      padding: 9px !important;
      background: #fff;
      border: 1px solid #dfe3e8 !important;
      border-radius: 8px !important;
    }

    .nckh-edit-participant .btn {
      width: 38px;
      height: 38px;
      padding: 0;
      color: #d92d20 !important;
      background: #fff !important;
      border-color: #fda29b !important;
    }

    .nckh-edit-participant .btn:hover {
      color: #b42318 !important;
      background: #fff5f4 !important;
      border-color: #f97066 !important;
    }

    .nckh-edit-add-participant {
      width: 100%;
      margin-top: 8px;
      color: #4361ee !important;
      background: #fff !important;
      border-color: #9aaefc !important;
      border-style: dashed;
    }

    .nckh-edit-add-participant:hover {
      color: #304acb !important;
      background: #f5f7ff !important;
      border-color: #4361ee !important;
    }

    @media (max-width: 640px) {
      .nckh-v3-swal-popup .swal2-title {
        padding: 15px 16px 12px;
        font-size: 1.05rem;
      }

      .nckh-v3-swal-popup .swal2-html-container {
        padding: 14px 16px 0 !important;
      }

      .nckh-detail-grid {
        grid-template-columns: 1fr;
      }

      .nckh-detail-item.is-wide {
        grid-column: auto;
      }

      .nckh-detail-item.is-full {
        grid-column: auto;
      }

      .nckh-edit-section {
        padding: 11px;
      }
    }
  </style>
</head>

<body>
  <%- include('../header') %>

  <div class="nckh-v3-list-wrap">
    <div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
      <h1 class="page-title mb-0">Danh sách NCKH</h1>
      <div class="d-flex gap-2">
        <a href="/v3/nckh/import" class="btn btn-outline-success btn-sm"><i class="bi bi-cloud-upload"></i> Import</a>
        <!-- <a href="/v3/nckh/thong-ke/giang-vien" class="btn btn-outline-primary btn-sm">TK theo GV</a>
        <a href="/v3/nckh/thong-ke/khoa" class="btn btn-outline-primary btn-sm">TK theo Khoa</a>
        <a href="/v3/nckh/thong-ke/hoc-vien" class="btn btn-outline-primary btn-sm">TK theo HV</a> -->
      </div>
    </div>

    <div class="nckh-v3-list-toolbar">
      <div class="toolbar-item">
        <select id="namHocFilter" class="form-select"></select>
      </div>

      <div class="toolbar-item">
        <select id="khoaFilter" class="form-select">
          <option value="ALL">Tất cả khoa</option>
        </select>
      </div>

      <div class="toolbar-item" style="min-width: 220px;">
        <input
          id="workNameSearchInput"
          class="form-control"
          placeholder="🔍 Tên công trình"
        />
      </div>

      <div class="toolbar-item" style="min-width: 220px;">
        <input
          id="authorMemberSearchInput"
          class="form-control"
          placeholder="🔍 Tác giả / thành viên"
        />
      </div>

      <div class="toolbar-action">
        <button id="loadDataBtn" class="btn btn-primary">
          <i class="bi bi-search"></i> Hiển thị
        </button>
        <button id="submitApprovalsBtn" class="btn btn-success" style="display: none;">
          <i class="bi bi-check-circle"></i> Lưu
        </button>
      </div>
    </div>

    <div id="recordCountInfo" class="nckh-v3-record-count"></div>

    <div class="nckh-v3-list-table">
      <table style="text-align: center;">
        <thead>
          <tr>
            <th>STT</th>
            <th class="sortable" data-sort="phan_loai">Phân loại <span class="sort-indicator"></span></th>
            <th class="sortable text-start" data-sort="ten_cong_trinh">Tên công trình <span class="sort-indicator"></span></th>
            <th>Mã số / Số QĐ</th>
            <th>Xếp loại</th>
            <th>Ngày NT</th>
            <th class="text-start">Tác giả / CN</th>
            <th class="text-start">Thành viên</th>
            <th>Khoa</th>
            <th>Số tiết</th>
            <th style="width: 56px;">
              <div style="line-height: 1.3;">
                Khoa
                <br />
                <input
                  type="checkbox"
                  id="selectAllKhoaDuyet"
                  class="nckh-v3-checkbox"
                  title="Chọn tất cả khoa duyệt"
                />
              </div>
            </th>
            <th style="width: 56px;">
              <div style="line-height: 1.3;">
                Viện
                <br />
                <input
                  type="checkbox"
                  id="selectAllVienDuyet"
                  class="nckh-v3-checkbox"
                  title="Chọn tất cả viện duyệt"
                />
              </div>
            </th>
            <th style="width: 80px;">Thao tác</th>
          </tr>
        </thead>
        <tbody id="recordsTableBody"></tbody>
      </table>
    </div>
  </div>

  <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.6.16/dist/sweetalert2.all.min.js"></script>

  <script src="/js/nckh_v3/main/permissions.js"></script>
  <script src="/js/nckh_v3/list/index.js"></script>
</body>

</html>
