<!DOCTYPE html>
<html lang="vi">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>NCKH V3 - Xuất mẫu kê khai cá nhân</title>

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
  <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.6.16/dist/sweetalert2.min.css" rel="stylesheet" />

  <link rel="stylesheet" href="/css/admin.css" />
  <link rel="stylesheet" href="/css/styles.css" />
  <link rel="stylesheet" href="/css/nckh_v3.css" />
  <link rel="stylesheet" href="/css/nckh_v3_stats.css" />
</head>

<body>
  <%- include('../header') %>

  <div class="stats-wrap">
    <!-- Page Header -->
    <div class="stats-page-header">
      <div>
        <h1 class="stats-page-title">
          <span class="title-icon"><i class="bi bi-file-earmark-word"></i></span>
          Xuất mẫu kê khai NCKH cá nhân
        </h1>
        <p style="color: var(--stats-text-secondary); font-size: 0.88rem; margin: 6px 0 0 54px;">
          Chọn năm học, phạm vi dữ liệu và xuất báo cáo NCKH cá nhân dưới dạng file Word (.docx) chuẩn biểu mẫu Học viện
        </p>
      </div>
    </div>

    <!-- Toolbar -->
    <div class="stats-toolbar">
      <div class="tb-group">
        <label for="reportNamHoc">Năm học</label>
        <select id="reportNamHoc" class="form-select"></select>
      </div>
      <div class="tb-group">
        <label for="reportScope">Trạng thái công trình</label>
        <select id="reportScope" class="form-select">
          <option value="PREVIEW" selected>Tất cả (Dự kiến / Kê khai)</option>
          <option value="OFFICIAL">Chính thức (Đã duyệt 2 cấp)</option>
        </select>
      </div>
      <div class="tb-group">
        <label for="reportKhoa">Khoa / Phòng ban</label>
        <select id="reportKhoa" class="form-select">
          <option value="ALL">Tất cả khoa</option>
        </select>
      </div>
      <div class="tb-group" style="min-width: 260px;">
        <label for="reportKeyword">Tìm giảng viên</label>
        <input id="reportKeyword" class="form-control" placeholder="Nhập tên giảng viên..." />
      </div>
      <div class="tb-actions">
        <button id="reportLoadBtn" class="btn btn-load">
          <i class="bi bi-search"></i> Hiển thị
        </button>
      </div>
    </div>

    <!-- Main Table -->
    <div class="stats-table-card table-responsive">
      <table class="table table-hover text-center align-middle">
        <thead>
          <tr>
            <th style="width: 60px">STT</th>
            <th class="text-start">Giảng viên</th>
            <th style="width: 140px">Khoa</th>
            <th style="width: 140px">Số công trình</th>
            <th style="width: 180px">Tổng số tiết</th>
            <th style="width: 120px">Xuất file</th>
          </tr>
        </thead>
        <tbody id="reportTableBody"></tbody>
      </table>
    </div>

    <!-- Export All Button -->
    <div class="d-flex justify-content-end mt-3">
      <button id="reportExportAllBtn" class="btn btn-export" style="display: none;">
        <i class="bi bi-download"></i> Xuất tất cả Word
      </button>
    </div>
  </div>

  <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.6.16/dist/sweetalert2.all.min.js"></script>
  <script src="/js/nckh_v3/stats/common.js"></script>
  <script src="/js/nckh_v3/report/lecturer.js"></script>
</body>

</html>
