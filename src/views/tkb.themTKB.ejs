            "
          >
            <div
              style="
                background: #ffffff;
                padding: 25px;
                border-radius: 12px;
                max-width: 480px;
                width: 90%;
                text-align: center;
                box-shadow: 0px 4px 20px rgba(0, 0, 0, 0.2);
